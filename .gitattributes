# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts MUST keep LF endings: a carriage return makes bash fail with
# "syntax error near unexpected token". This overrides any editor or tool that
# would otherwise write CRLF on Windows.
*.sh   text eol=lf
*.bash text eol=lf

# Scripts and documentation in this repository are all LF.
*.py   text eol=lf
*.R    text eol=lf
*.r    text eol=lf
*.md   text eol=lf
*.tsv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.txt  text eol=lf
*.list text eol=lf
*.bed  text eol=lf
*.fa   text eol=lf
*.fai  text eol=lf

# Demos ship small inputs and expected outputs; keep those byte-stable too.
demo/** text eol=lf
